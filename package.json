{
  "name": "nhl-macros-web",
  "version": "2.0.0",
  "description": "Generate text-expansion macros for NHL team rosters",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:api": "node scripts/local-api.mjs",
    "dev:local": "VITE_API_URL=http://localhost:3000 vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "deploy": "npm run build && terraform -chdir=infra apply"
  },
  "author": "",
  "license": "ISC",
  "dependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "typescript": "^5.6.3",
    "vite": "^5.4.11"
  }
}
